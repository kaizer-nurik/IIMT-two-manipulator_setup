# Copy to .env. Linux host networking; all peers must use matching ROS settings.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Safe defaults: real hardware needs an explicit change to BOTH settings.
USE_MOCK_HARDWARE=true
ENABLE_MOTION=false
LAUNCH_RVIZ=false
# These physical addresses are examples; confirm your actual wiring/IPs.
ROBOT_IP=192.168.50.95
LEFT_ROBOT_IP=192.168.50.92
RIGHT_ROBOT_IP=192.168.50.95
COMMAND_RATE=125.0
READ_RATE=125.0
READ_TIMEOUT=0.1
FEEDBACK_TRANSPORT=tcp
TRAJECTORY_ADVANCE_MS=0.0
LEFT_COMMAND_RATE=125.0
RIGHT_COMMAND_RATE=125.0
LEFT_READ_RATE=125.0
RIGHT_READ_RATE=125.0
LEFT_READ_TIMEOUT=0.1
RIGHT_READ_TIMEOUT=0.1
LEFT_FEEDBACK_TRANSPORT=tcp
RIGHT_FEEDBACK_TRANSPORT=tcp
# Advance is experiment-dependent, not a universal correction.
LEFT_TRAJECTORY_ADVANCE_MS=0.0
RIGHT_TRAJECTORY_ADVANCE_MS=0.0
# xyz metres; rpy radians. LEFT: world->left. RIGHT: left->right, NOT world->right.
LEFT_BASE_XYZ="-0.0008297 -0.5380000 0.0818739"
LEFT_BASE_RPY="0 0 -0.6981317008"
RIGHT_BASE_XYZ="-0.345440489323 0.411679944176 -0.082000000000"
RIGHT_BASE_RPY="0 0 0"
WORKSPACE_MARGIN=0.5
FLOOR_Z=auto
# Optional additional ROS launch arguments; quote multi-value arguments inside.
LAUNCH_ARGS=
JUPYTER_PORT=8888
# Leave unset/empty for an auto-generated token (view make logs SERVICE=notebook).
JUPYTER_TOKEN=
