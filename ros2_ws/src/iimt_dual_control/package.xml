<?xml version="1.0"?>
<package format="3">
  <name>iimt_dual_control</name><version>0.2.0</version>
  <description>Two direct IIMT drivers with a synchronized twelve-joint action coordinator.</description>
  <maintainer email="maintainer@example.com">IIMT workspace maintainers</maintainer>
  <license>Apache-2.0</license>
  <build_depend>python3-setuptools</build_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>rcl_interfaces</exec_depend><exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>iimt_ros2_driver</exec_depend><exec_depend>control_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
