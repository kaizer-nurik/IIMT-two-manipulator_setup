<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="iimt10">
    <xacro:arg name="initial_positions_file" default="$(find iimt_ros2_description)/config/initial_positions.yaml" />

    <!-- Import iimt5 urdf file -->
    <xacro:include filename="$(find iimt_ros2_description)/urdf/iimt10.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="iimt10.ros2_control.xacro" />


    <xacro:iimt10_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
