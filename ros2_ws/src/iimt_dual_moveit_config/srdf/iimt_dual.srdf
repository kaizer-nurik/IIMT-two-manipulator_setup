<robot name="iimt_dual">
  <group name="left_arm">
    <chain base_link="left_base_link" tip_link="left_wrist_3_link" />
  </group>
  <group name="right_arm">
    <chain base_link="right_base_link" tip_link="right_wrist_3_link" />
  </group>
  <group name="both_arms">
    <group name="left_arm" />
    <group name="right_arm" />
  </group>
  <disable_collisions link1="left_base_link" link2="left_shoulder_link" reason="User" />
  <disable_collisions link1="left_base_link" link2="left_upper_arm_link" reason="User" />
  <disable_collisions link1="left_forearm_link" link2="left_upper_arm_link" reason="User" />
  <disable_collisions link1="left_forearm_link" link2="left_wrist_1_link" reason="User" />
  <disable_collisions link1="left_shoulder_link" link2="left_upper_arm_link" reason="User" />
  <disable_collisions link1="left_wrist_1_link" link2="left_wrist_2_link" reason="User" />
  <disable_collisions link1="left_wrist_1_link" link2="left_wrist_3_link" reason="User" />
  <disable_collisions link1="left_wrist_2_link" link2="left_wrist_3_link" reason="User" />
  <disable_collisions link1="right_base_link" link2="right_shoulder_link" reason="User" />
  <disable_collisions link1="right_base_link" link2="right_upper_arm_link" reason="User" />
  <disable_collisions link1="right_forearm_link" link2="right_upper_arm_link" reason="User" />
  <disable_collisions link1="right_forearm_link" link2="right_wrist_1_link" reason="User" />
  <disable_collisions link1="right_shoulder_link" link2="right_upper_arm_link" reason="User" />
  <disable_collisions link1="right_wrist_1_link" link2="right_wrist_2_link" reason="User" />
  <disable_collisions link1="right_wrist_1_link" link2="right_wrist_3_link" reason="User" />
  <disable_collisions link1="right_wrist_2_link" link2="right_wrist_3_link" reason="User" />
</robot>
